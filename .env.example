# --- App ---
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Supabase riseskill (Auth + managed Postgres) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Asymmetric JWT verification (JWKS), not a shared HS256 secret.
SUPABASE_JWKS_URL=https://xxxxx.supabase.co/auth/v1/.well-known/jwks.json

# --- Database (Prisma against Supabase Postgres) ---
# DATABASE_URL = transaction pooler (app runtime)
# DIRECT_URL   = session pooler (Prisma migrations)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-x-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-x-region.pooler.supabase.com:5432/postgres

# --- Cookies / app-level secrets ---
COOKIE_SECRET=change-me-in-production

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Landing pages / ads (Skikda) ---
# WhatsApp click-to-chat number for /formation/[slug] landing pages, E.164 without "+" (Algeria: 213).
NEXT_PUBLIC_WHATSAPP_NUMBER=213xxxxxxxxx

# --- Intégration RISE ERP (Phase 4 du plan — restreinte INSERT-only sur contact_requests) ---
ERP_SUPABASE_URL=
ERP_SERVICE_KEY=

# --- Stockage images (Cloudflare R2) ---
# Cloudflare dashboard > R2 > Créer un bucket, puis "Manage API tokens" pour la clé/secret.
# R2_PUBLIC_URL = domaine public du bucket (r2.dev ou domaine personnalisé), sans slash final.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
